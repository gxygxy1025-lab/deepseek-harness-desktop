{
  "name": "deepseek-harness-desktop",
  "version": "1.0.10",
  "private": true,
  "description": "DeepSeek Harness Desktop core release workspace",
  "scripts": {
    "test": "pnpm --filter @deepseek-ai/dsh-desktop test",
    "typecheck": "pnpm -r --if-present typecheck",
    "desktop:dev": "pnpm --filter @deepseek-ai/dsh-desktop dev",
    "desktop:test": "pnpm --filter @deepseek-ai/dsh-desktop test",
    "desktop:pack": "pnpm --filter @deepseek-ai/dsh-desktop pack:win",
    "desktop:pack:win": "pnpm --filter @deepseek-ai/dsh-desktop pack:win",
    "desktop:pack:mac": "pnpm --filter @deepseek-ai/dsh-desktop pack:mac",
    "desktop:pack:mac:x64": "pnpm --filter @deepseek-ai/dsh-desktop pack:mac:x64",
    "desktop:pack:mac:arm64": "pnpm --filter @deepseek-ai/dsh-desktop pack:mac:arm64",
    "verify": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "license": "BSD-3-Clause"
}
