{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "1.0.9",
  "private": true,
  "description": "Desktop shell for the official DeepSeek Harness runtime",
  "author": "DeepSeek Harness Desktop contributors",
  "type": "module",
  "main": "src/main.mjs",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "electron src/main.mjs",
    "measure:profile": "node scripts/measure-profile.mjs",
    "measure:packaged-startup": "node scripts/measure-packaged-startup.mjs",
    "test:settings-window:e2e": "node scripts/verify-settings-window.mjs",
    "test:conversation-skills:e2e": "node scripts/verify-conversation-skills.mjs",
    "test:directory-picker:e2e": "node scripts/verify-directory-picker.mjs",
    "test:runtime-provider:e2e": "node scripts/verify-runtime-provider.mjs",
    "test:update-shutdown:e2e": "node scripts/verify-update-shutdown.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dir": "electron-builder --dir",
    "pack:verify": "node scripts/verify-package.mjs",
    "pack:verify:dir": "node scripts/verify-package.mjs --allow-missing-update-metadata",
    "pack:smoke": "node scripts/verify-packaged-smoke.mjs",
    "pack:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry-otel": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "electron-updater": "6.8.9",
    "koffi": "3.1.6",
    "pnpm": "11.22.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  }
}
